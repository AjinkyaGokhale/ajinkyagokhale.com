<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Mozilla/5.0" version="24.0.0">
  <diagram name="apimyresume architecture" id="apimyresume-1">
    <mxGraphModel dx="1422" dy="780" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="apimyresume architecture" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#0f172a" vertex="1" parent="1">
          <mxGeometry x="450" y="20" width="300" height="40" as="geometry" />
        </mxCell>

        <mxCell id="subtitle" value="One Docker image. Master resume in SQLite, child resumes rendered as PDFs via Typst." style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#475569" vertex="1" parent="1">
          <mxGeometry x="300" y="60" width="600" height="30" as="geometry" />
        </mxCell>

        <!-- Docker container -->
        <mxCell id="docker" value="Docker image · localhost:3000" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#0f172a;strokeWidth=2;fontSize=14;fontStyle=1;verticalAlign=top;align=center;spacingTop=10;fontColor=#0f172a" vertex="1" parent="1">
          <mxGeometry x="380" y="100" width="440" height="320" as="geometry" />
        </mxCell>

        <!-- Dashboard -->
        <mxCell id="dashboard" value="Dashboard (SPA)&#10;&#10;· Resume editor&#10;· PDF preview&#10;· API key management&#10;&#10;Bun-served" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#0f172a;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;fontColor=#0f172a" vertex="1" parent="1">
          <mxGeometry x="410" y="160" width="170" height="120" as="geometry" />
        </mxCell>

        <!-- API -->
        <mxCell id="api" value="REST API&#10;Bun · Hono · TypeScript&#10;&#10;POST /api/tailored-resumes&#10;GET  /api/base-resumes&#10;GET  /api/templates" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#0f172a;strokeWidth=1.5;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#0f172a" vertex="1" parent="1">
          <mxGeometry x="610" y="160" width="190" height="120" as="geometry" />
        </mxCell>

        <!-- SQLite -->
        <mxCell id="sqlite" value="SQLite&#10;master + child resumes · one file on a volume" style="shape=cylinder3;whiteSpace=wrap;html=0;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#0f172a;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;fontColor=#0f172a" vertex="1" parent="1">
          <mxGeometry x="490" y="330" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- Caller: AI Agent -->
        <mxCell id="agent" value="AI Agent&#10;LLM tool call · LangChain / OpenAI / Claude" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#0f172a;strokeWidth=1.5;dashed=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#0f172a" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="290" height="56" as="geometry" />
        </mxCell>

        <!-- Caller: n8n -->
        <mxCell id="n8n" value="n8n workflow&#10;HTTP Request node · application/pdf" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#0f172a;strokeWidth=1.5;dashed=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#0f172a" vertex="1" parent="1">
          <mxGeometry x="40" y="266" width="290" height="56" as="geometry" />
        </mxCell>

        <!-- Caller: Zapier -->
        <mxCell id="zapier" value="Zapier&#10;Webhooks action · POST" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#0f172a;strokeWidth=1.5;dashed=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#0f172a" vertex="1" parent="1">
          <mxGeometry x="40" y="332" width="290" height="56" as="geometry" />
        </mxCell>

        <!-- PDF render -->
        <mxCell id="pdf" value="PDF render&#10;Typst compiles the child resume template&#10;in milliseconds · version-controlled markup&#10;tailored-resume.pdf" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#0f172a;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;fontColor=#0f172a" vertex="1" parent="1">
          <mxGeometry x="880" y="190" width="270" height="100" as="geometry" />
        </mxCell>

        <!-- Arrows: callers -> API. Each enters the API at a different y so they don't collide. -->
        <!-- AI Agent (top) -> API top entry -->
        <mxCell id="a1" style="endArrow=classic;html=0;exitX=1;exitY=0.5;entryX=0;entryY=0.15;strokeColor=#c2410c;strokeWidth=2" edge="1" parent="1" source="agent" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- n8n (middle) -> API middle entry -->
        <mxCell id="a2" style="endArrow=classic;html=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#c2410c;strokeWidth=2" edge="1" parent="1" source="n8n" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Zapier (bottom) -> API bottom entry -->
        <mxCell id="a3" style="endArrow=classic;html=0;exitX=1;exitY=0.5;entryX=0;entryY=0.85;strokeColor=#c2410c;strokeWidth=2" edge="1" parent="1" source="zapier" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow: Dashboard -> API. Exit from the right edge near the bottom; entry on the left edge of API near the top. Routes around the dashboard's text. -->
        <mxCell id="a_dash" style="endArrow=classic;html=0;exitX=1;exitY=0.85;entryX=0;entryY=0.3;strokeColor=#0f172a;strokeWidth=1.5" edge="1" parent="1" source="dashboard" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow: API -> PDF render -->
        <mxCell id="a4" style="endArrow=classic;html=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#c2410c;strokeWidth=2" edge="1" parent="1" source="api" target="pdf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow: API -> SQLite -->
        <mxCell id="a5" style="endArrow=classic;html=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#c2410c;strokeWidth=2" edge="1" parent="1" source="api" target="sqlite">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow: PDF -> caller (return), curved. Hits the bottom of the AI Agent box. -->
        <mxCell id="a6" style="endArrow=classic;html=0;exitX=0.5;exitY=1;entryX=0.5;entryY=1;curved=1;strokeColor=#c2410c;strokeWidth=2;dashed=1" edge="1" parent="1" source="pdf" target="agent">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1015" y="470" />
              <mxPoint x="185" y="470" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Footer notes -->
        <mxCell id="note1" value="Master resume is read-only to callers — only the child is mutated per job." style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#475569" vertex="1" parent="1">
          <mxGeometry x="300" y="540" width="600" height="20" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="Self-host with docker compose up -d · API key printed in logs on first boot." style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#475569" vertex="1" parent="1">
          <mxGeometry x="300" y="560" width="600" height="20" as="geometry" />
